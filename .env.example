# Copie este arquivo para .env e preencha com os seus dados.
# O arquivo .env NUNCA deve ir para o GitHub (já está no .gitignore).

# ===== APLICAÇÃO =====
PORT=3000
NODE_ENV=development

# ===== BANCO DE DADOS (TiDB Serverless - Gratuito) =====
# Copie estas informações de: https://tidbcloud.com/console
# Seu cluster → Connect → MySQL Client

DB_HOST=seu_host.tidbcloud.com
DB_PORT=4000
DB_USER=seu_usuario
DB_PASSWORD=sua_senha_gerada
DB_NAME=sharktech_ceep

# ===== AUTENTICAÇÃO =====
# Gere uma chave forte com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

SESSION_SECRET=troque-esta-chave-por-um-texto-longo-e-aleatorio
