# Copie este arquivo para .env e preencha com os seus dados.
# O arquivo .env NUNCA deve ir para o GitHub (já está no .gitignore).

# ===== APLICAÇÃO =====
PORT=3000
NODE_ENV=development

# ===== BANCO DE DADOS =====
# Para MySQL local, deixe DB_SSL=false.
# Para TiDB Serverless ou outros bancos que exigem TLS, use DB_SSL=true.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_local
DB_NAME=sharktech_ceep
DB_SSL=false

# ===== AUTENTICAÇÃO =====
# Gere uma chave forte com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Mínimo obrigatório: 32 caracteres
SESSION_SECRET=troque-esta-chave-por-um-texto-longo-aleatorio-com-32-caracteres-ou-mais
